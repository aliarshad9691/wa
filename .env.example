# ---- Auth (Auth.js / NextAuth v5) ----
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# Google OAuth client (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated Google accounts allowed to sign in (required — nobody else gets in)
ALLOWED_EMAILS=you@gmail.com

# ---- Media storage (S3 or S3-compatible: R2, MinIO, B2, ...) ----
# If S3_BUCKET is empty, media is stored on local disk under ./data/media (dev only).
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only for S3-compatible services:
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# ---- App ----
# Where SQLite DB + WhatsApp session keys live
DATA_DIR=./data
# Parallel media downloads to storage
MEDIA_CONCURRENCY=3
# Baileys log level: silent | error | warn | info | debug
WA_LOG_LEVEL=warn

# Media older than this many days is downloaded only when you click it (0 = download everything)
MEDIA_AUTO_DAYS=30
# Set to 1 to pull the phone's entire history when linking (default: recent chats only)
SYNC_FULL_HISTORY=0

# Typing this in the search bar shows the hidden chats of filtered numbers
HIDDEN_CHATS_CODE=1010

# ---- Docker deployment (compose.yml) ----
# Public domain served via nginx-proxy + Let's Encrypt. Its DNS A record must point at the server.
# Also add https://<APP_DOMAIN>/api/auth/callback/google as a Google OAuth redirect URI.
APP_DOMAIN=
